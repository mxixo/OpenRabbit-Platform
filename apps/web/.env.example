# OpenRabbit web client environment template.
# Select the intended account boundary explicitly for each environment.
# Never commit or inherit a production project URL/key through this template.
# When any Supabase client setting is supplied for a production build, all three
# values below are required and the URL must match the explicit project ref.
VITE_SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional explicit Connection Gateway origin. Leave blank when /v1/* is
# reverse-proxied on the same origin as the web app.
VITE_OPENRABBIT_CONNECTION_GATEWAY_URL=
