OPENRABBIT_CONNECTION_GATEWAY_HOST=0.0.0.0
OPENRABBIT_CONNECTION_GATEWAY_PORT=8790
OPENRABBIT_CONNECTION_GATEWAY_PUBLIC_URL=https://gateway.openrabbit.example
OPENRABBIT_GATEWAY_DATA_DIR=/data
# Use a long random value; clients send it as Bearer token.
OPENRABBIT_GATEWAY_APP_TOKEN=
# Use at least 32 random characters. Tokens are encrypted at rest with AES-256-GCM.
OPENRABBIT_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional browser key used by the desktop dashboard map.
GOOGLE_MAPS_BROWSER_KEY=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read
OPENRABBIT_GATEWAY_CORS_ORIGIN=*
