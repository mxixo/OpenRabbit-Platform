# OpenRabbit Platform environment template
# Copy to .env for local development. Production provider credentials belong only on the hosted gateway.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000

# Commercial real-estate API (server only)
OPENRABBIT_API_HOST=127.0.0.1
OPENRABBIT_API_PORT=3000
OPENRABBIT_API_TOKEN=
OPENRABBIT_ACTOR_ID=
OPENRABBIT_ORG_ID=
OPENRABBIT_ALLOWED_OUTREACH_RECIPIENTS=test-recipient@openrabbit.local
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Productivity API used by the OpenRabbit desktop workspace
OPENRABBIT_PRODUCTIVITY_HOST=127.0.0.1
OPENRABBIT_PRODUCTIVITY_PORT=8787

# Hosted OpenRabbit Connection Gateway.
# The desktop app only needs the public URL. Customers never enter provider API keys or OAuth credentials.
OPENRABBIT_CONNECTION_GATEWAY_URL=
OPENRABBIT_CONNECTION_GATEWAY_HOST=127.0.0.1
OPENRABBIT_CONNECTION_GATEWAY_PORT=8790
OPENRABBIT_CONNECTION_GATEWAY_PUBLIC_URL=http://127.0.0.1:8790
OPENRABBIT_GATEWAY_APP_TOKEN=
OPENRABBIT_TOKEN_ENCRYPTION_KEY=
OPENRABBIT_GATEWAY_CORS_ORIGIN=
OPENRABBIT_GATEWAY_DATA_DIR=.openrabbit-gateway

# Future OpenRabbit account/session identity.
# OPENRABBIT_SESSION_TOKEN will replace the temporary installation identity once hosted account auth is enabled.
OPENRABBIT_SESSION_TOKEN=

# Google Gmail + Calendar provider application (GATEWAY/SERVER ONLY in production).
# Customers simply click Connect Gmail / Connect Calendar and use the normal Google sign-in screen.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# HubSpot provider application (GATEWAY/SERVER ONLY in production).
# Customers simply click Connect HubSpot and use the normal HubSpot sign-in screen.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read

# Google Maps platform capability (GATEWAY/SERVER managed).
# Browser keys are inherently renderer-visible, so restrict this key to the Maps JavaScript API and approved OpenRabbit origins.
GOOGLE_MAPS_BROWSER_KEY=

# OpenRabbit desktop workspace local HTTP origin.
OPENRABBIT_DESKTOP_PORT=53683

# Existing productivity integration runtime (development / service adapters)
GOOGLE_OAUTH_TOKEN_FILE=.openrabbit/google-oauth.json
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_GMAIL_USER_ID=me
GOOGLE_CALENDAR_ID=primary
OPENRABBIT_MAIL_SCAN_QUERY=is:unread
OPENRABBIT_MAIL_SCAN_LIMIT=25
OPENRABBIT_MAIL_SCAN_INTERVAL_MS=300000
OPENRABBIT_MEETING_PROPOSAL_FILE=.openrabbit/meeting-proposals.json
OPENRABBIT_TIME_ZONE=America/Phoenix

# OpenAI integration (server/main-process only; never expose a key to renderer/browser code).
OPENAI_API_KEY=
OPENRABBIT_AGENT_MODEL=gpt-5.6
OPENRABBIT_MEETING_MODEL=gpt-5-mini
MODEL_PROVIDER=auto

# Legacy/local HubSpot adapter variables remain available for development only.
# Presence alone must never be treated as a verified live customer connection.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# OpenRabbit commercial workflow scaffold
CAMINO_API_KEY=
