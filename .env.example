OPENAI_API_KEY={{OPENAI_API_KEY}}
CAMINO_API_KEY={{CAMINO_API_KEY}}

# Social platform tokens (set only the platforms you use in live mode)
META_PAGE_ACCESS_TOKEN={{META_PAGE_ACCESS_TOKEN}}
META_IG_ACCESS_TOKEN={{META_IG_ACCESS_TOKEN}}
X_API_BEARER_TOKEN={{X_API_BEARER_TOKEN}}
LINKEDIN_ACCESS_TOKEN={{LINKEDIN_ACCESS_TOKEN}}

# HubSpot live CRM integration
HUBSPOT_ACCESS_TOKEN={{HUBSPOT_ACCESS_TOKEN}}
HUBSPOT_DEFAULT_PIPELINE={{HUBSPOT_DEFAULT_PIPELINE}}
HUBSPOT_DEFAULT_DEALSTAGE={{HUBSPOT_DEFAULT_DEALSTAGE}}
HUBSPOT_CONTACT_OWNER_ID={{HUBSPOT_CONTACT_OWNER_ID}}
HUBSPOT_DEAL_OWNER_ID={{HUBSPOT_DEAL_OWNER_ID}}
# JSON object strings, e.g. {"leadSource":"lead_source"}
HUBSPOT_CONTACT_FIELD_MAP_JSON={{HUBSPOT_CONTACT_FIELD_MAP_JSON}}
HUBSPOT_DEAL_FIELD_MAP_JSON={{HUBSPOT_DEAL_FIELD_MAP_JSON}}

# Google Calendar live scheduling integration
GOOGLE_CALENDAR_ACCESS_TOKEN={{GOOGLE_CALENDAR_ACCESS_TOKEN}}
GOOGLE_CALENDAR_ID={{GOOGLE_CALENDAR_ID}}
GOOGLE_CALENDAR_TIMEZONE={{GOOGLE_CALENDAR_TIMEZONE}}
GOOGLE_CALENDAR_DURATION_MINUTES={{GOOGLE_CALENDAR_DURATION_MINUTES}}
# JSON array string, e.g. [{"email":"coordinator@example.com","displayName":"Coordinator"}]
GOOGLE_CALENDAR_DEFAULT_ATTENDEES_JSON={{GOOGLE_CALENDAR_DEFAULT_ATTENDEES_JSON}}
GOOGLE_CALENDAR_DEFAULT_SUMMARY={{GOOGLE_CALENDAR_DEFAULT_SUMMARY}}
GOOGLE_CALENDAR_DEFAULT_DESCRIPTION={{GOOGLE_CALENDAR_DEFAULT_DESCRIPTION}}

# DocuSign live e-sign integration
DOCUSIGN_ACCESS_TOKEN={{DOCUSIGN_ACCESS_TOKEN}}
DOCUSIGN_ACCOUNT_ID={{DOCUSIGN_ACCOUNT_ID}}
DOCUSIGN_BASE_URL={{DOCUSIGN_BASE_URL}}
DOCUSIGN_TEMPLATE_ID={{DOCUSIGN_TEMPLATE_ID}}
# JSON array string, e.g. ["Buyer","Seller"]
DOCUSIGN_TEMPLATE_ROLE_NAMES_JSON={{DOCUSIGN_TEMPLATE_ROLE_NAMES_JSON}}
DOCUSIGN_DEFAULT_SIGNER_ROLE={{DOCUSIGN_DEFAULT_SIGNER_ROLE}}
DOCUSIGN_DEFAULT_SUBJECT={{DOCUSIGN_DEFAULT_SUBJECT}}
