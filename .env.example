# OpenRabbit Platform environment template
# Copy to .env and fill with environment-specific values.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000

# Commercial real-estate API (server only)
OPENRABBIT_API_HOST=127.0.0.1
OPENRABBIT_API_PORT=3000
OPENRABBIT_API_TOKEN=
OPENRABBIT_ACTOR_ID=
OPENRABBIT_ORG_ID=
OPENRABBIT_ALLOWED_OUTREACH_RECIPIENTS=test-recipient@openrabbit.local
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Productivity API used by the OpenRabbit desktop workspace
OPENRABBIT_PRODUCTIVITY_HOST=127.0.0.1
OPENRABBIT_PRODUCTIVITY_PORT=8787

# Production Connection Gateway.
# Desktop apps should only need the public gateway URL; provider secrets belong on the hosted gateway/VPS.
OPENRABBIT_CONNECTION_GATEWAY_URL=
OPENRABBIT_CONNECTION_GATEWAY_HOST=127.0.0.1
OPENRABBIT_CONNECTION_GATEWAY_PORT=8790
OPENRABBIT_CONNECTION_GATEWAY_PUBLIC_URL=http://127.0.0.1:8790
# Generate a long random server-only state secret before enabling OAuth routes in production.
OPENRABBIT_CONNECTION_GATEWAY_STATE_SECRET=
# Future hosted gateway authentication/token-vault configuration.
OPENRABBIT_CONNECTION_GATEWAY_JWT_ISSUER=
OPENRABBIT_CONNECTION_GATEWAY_JWT_AUDIENCE=
OPENRABBIT_CONNECTION_TOKEN_ENCRYPTION_KEY=

# Google productivity integration.
# DEVELOPMENT ONLY when used directly by the desktop app. In the commercial product these provider
# credentials should live only on the hosted Connection Gateway, never inside the downloadable app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_FILE=.openrabbit/google-oauth.json
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_CALLBACK_PORT=53682
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth/google/callback
GOOGLE_GMAIL_USER_ID=me
GOOGLE_CALENDAR_ID=primary
OPENRABBIT_MAIL_SCAN_QUERY=is:unread
OPENRABBIT_MAIL_SCAN_LIMIT=25
OPENRABBIT_MAIL_SCAN_INTERVAL_MS=300000
OPENRABBIT_MEETING_PROPOSAL_FILE=.openrabbit/meeting-proposals.json
OPENRABBIT_TIME_ZONE=America/Phoenix

# OpenRabbit desktop workspace is served locally over HTTP so browser-key referrer restrictions can work.
# Add http://127.0.0.1:53683/* as an allowed website/referrer for the Maps browser key.
OPENRABBIT_DESKTOP_PORT=53683

# Google Maps JavaScript API browser key.
# This key is intentionally renderer-visible. Restrict it to Maps JavaScript API only and allow
# the local OpenRabbit desktop origin above. Do not use a server/admin key here.
GOOGLE_MAPS_BROWSER_KEY=

# OpenAI integration (server/main-process only; never expose this key to renderer/browser code).
# For the commercial product, centrally hosted model credentials belong behind the backend gateway.
OPENAI_API_KEY=
OPENRABBIT_AGENT_MODEL=gpt-5.6
OPENRABBIT_MEETING_MODEL=gpt-5-mini

# Model gateway
MODEL_PROVIDER=auto

# HubSpot CRM OAuth.
# DEVELOPMENT ONLY when used directly by desktop. Production HubSpot app credentials belong on the Connection Gateway.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_CALLBACK_PORT=53684
HUBSPOT_OAUTH_REDIRECT_URI=http://127.0.0.1:53684/oauth/hubspot/callback
HUBSPOT_OAUTH_TOKEN_FILE=.openrabbit/hubspot-oauth.json
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read
# Legacy/private-app variables remain available for development only; presence alone must not be treated as a verified live connection.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# OpenRabbit commercial workflow scaffold
CAMINO_API_KEY=
