# OpenRabbit Platform environment template
# Copy to .env and fill with environment-specific values.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000

# Commercial real-estate API (server only)
OPENRABBIT_API_HOST=127.0.0.1
OPENRABBIT_API_PORT=3000
OPENRABBIT_API_TOKEN=
OPENRABBIT_ACTOR_ID=
OPENRABBIT_ORG_ID=
OPENRABBIT_ALLOWED_OUTREACH_RECIPIENTS=test-recipient@openrabbit.local
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Model gateway
MODEL_PROVIDER=auto

# Meeting-ready prototype server
OPENRABBIT_PROTOTYPE_PORT=8787
OPENRABBIT_APP_ORIGIN=http://localhost:8787
OPENRABBIT_PROTOTYPE_USER_ID=prototype-user
OPENRABBIT_SCAN_INTERVAL_MS=600000

# Google OAuth (server only). One OAuth client can connect multiple Google accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/gmail/callback

# Google Maps JavaScript API browser key.
GOOGLE_MAPS_BROWSER_KEY=

# OpenAI Responses provider (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENRABBIT_OPENAI_TOOLS_JSON=[]

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8787/api/integrations/hubspot/callback
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Social provider apps. These enable connection setup in Social Studio.
# Meta app powers Facebook Pages and Instagram professional accounts.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8787/api/integrations/social/meta/callback

# LinkedIn app; request Sign In with LinkedIn + Share on LinkedIn products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/api/integrations/social/linkedin/callback

# TikTok developer app; Content Posting API scopes require app approval.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8787/api/integrations/social/tiktok/callback

# OpenRabbit commercial workflow scaffold
CAMINO_API_KEY=
