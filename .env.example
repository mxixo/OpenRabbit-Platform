# OpenRabbit Platform environment template
# Copy to .env for local development. Production provider credentials belong only on the hosted gateway.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000

# Commercial real-estate API (server only)
OPENRABBIT_API_HOST=127.0.0.1
OPENRABBIT_API_PORT=3000
OPENRABBIT_API_TOKEN=
OPENRABBIT_ACTOR_ID=
OPENRABBIT_ORG_ID=
OPENRABBIT_ALLOWED_OUTREACH_RECIPIENTS=test-recipient@openrabbit.local

# OpenRabbit account system (Supabase Auth).
# SUPABASE_PUBLISHABLE_KEY is safe to include in desktop/web clients. SUPABASE_SECRET_KEY is server-only.
SUPABASE_URL=https://djplmhglilcwqfotnjew.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZdtVEN0fzdTEQyfQRLfhDA_zjKarn2n
SUPABASE_SECRET_KEY=

# Productivity API used by the OpenRabbit desktop workspace
OPENRABBIT_PRODUCTIVITY_HOST=127.0.0.1
OPENRABBIT_PRODUCTIVITY_PORT=8787

# Hosted OpenRabbit Connection Gateway.
# The desktop app only needs the public URL. Customers never enter provider API keys or OAuth credentials.
OPENRABBIT_CONNECTION_GATEWAY_URL=https://openrabbit.93-188-163-198.sslip.io
OPENRABBIT_CONNECTION_GATEWAY_HOST=127.0.0.1
OPENRABBIT_CONNECTION_GATEWAY_PORT=8790
OPENRABBIT_CONNECTION_GATEWAY_PUBLIC_URL=https://openrabbit.93-188-163-198.sslip.io
OPENRABBIT_GATEWAY_APP_TOKEN=
OPENRABBIT_TOKEN_ENCRYPTION_KEY=
OPENRABBIT_GATEWAY_CORS_ORIGIN=
OPENRABBIT_GATEWAY_DATA_DIR=.openrabbit-gateway

# Google Gmail + Calendar provider application (SERVER ONLY).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft 365 / Outlook mail + calendar provider application (SERVER ONLY).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_OAUTH_SCOPES=openid profile email offline_access User.Read Mail.Read Calendars.Read

# HubSpot CRM provider application (SERVER ONLY).
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read

# Google Maps platform capability (SERVER managed; optional enhancement).
# OpenRabbit includes a zero-config OpenStreetMap fallback when this is empty.
# If supplied, restrict this browser key to Maps JavaScript API and approved OpenRabbit origins.
GOOGLE_MAPS_BROWSER_KEY=

# Meta / Instagram / Facebook (SERVER ONLY).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,instagram_basic,instagram_manage_insights

# LinkedIn (SERVER ONLY). Baseline connection uses OpenID profile scopes.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=openid profile email

# TikTok (SERVER ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_SCOPES=user.info.basic,video.list

# OpenRabbit desktop workspace local HTTP origin.
OPENRABBIT_DESKTOP_PORT=53683

# Existing productivity integration runtime (development / service adapters)
GOOGLE_OAUTH_TOKEN_FILE=.openrabbit/google-oauth.json
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_GMAIL_USER_ID=me
GOOGLE_CALENDAR_ID=primary
OPENRABBIT_MAIL_SCAN_QUERY=is:unread
OPENRABBIT_MAIL_SCAN_LIMIT=25
OPENRABBIT_MAIL_SCAN_INTERVAL_MS=300000
OPENRABBIT_MEETING_PROPOSAL_FILE=.openrabbit/meeting-proposals.json
OPENRABBIT_TIME_ZONE=America/Phoenix

# OpenAI integration (server/main-process only; never expose a key to renderer/browser code).
OPENAI_API_KEY=
OPENRABBIT_AGENT_MODEL=gpt-5.6
OPENRABBIT_MEETING_MODEL=gpt-5-mini
MODEL_PROVIDER=auto

# Legacy/local HubSpot adapter variables remain available for development only.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# OpenRabbit commercial workflow scaffold
CAMINO_API_KEY=
